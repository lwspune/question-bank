# Supabase project (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — do NOT expose to client. Used by seed scripts, the admin
# server actions, and the public /api/sync/mock receiver.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by `npm run db:types` to generate TS types from the live schema.
SUPABASE_PROJECT_REF=your-project-ref

# Shared secret for the cross-project sync receiver at /api/sync/mock.
# Set the same value in MHT_CET_AI's env so its publisher can authenticate.
# Generate a long random value: `openssl rand -base64 48`.
SYNC_SHARED_SECRET=your-long-random-secret

# Kill switch for the six ANON funnel events sent to Vercel Web Analytics
# (reveal wall, teacher gate, quiz gate). UNSET MEANS ON — a missing variable
# must not silently kill the feature, so only an explicit off/0/false/no
# disables it. Pageviews are unaffected either way.
#
# This is a BUILD-TIME switch (Next inlines NEXT_PUBLIC_* into the bundle), so
# changing it needs a redeploy. To stop collection INSTANTLY, turn off Web
# Analytics in the Vercel dashboard — that kills pageviews too.
NEXT_PUBLIC_FUNNEL_ANALYTICS=on

# Microsoft Clarity project id (session recordings + heatmaps). UNSET MEANS OFF —
# the tag is never emitted without one. Build-time like the switch above, so a
# change needs a redeploy. It only ever loads on non-staff routes
# (src/lib/analytics/clarity.ts); the privacy page names it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google One Tap at the answer-reveal wall (src/lib/auth/oneTap.ts). The SAME
# web OAuth client id Supabase's Google provider uses (Supabase -> Auth ->
# Providers -> Google -> Client IDs). Public by design. UNSET OR MALFORMED MEANS
# OFF: the wall keeps its plain Sign in link. Build-time, so a change needs a
# redeploy. Each site origin must be an Authorized JavaScript origin on that
# client in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
