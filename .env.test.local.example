# Template for the dedicated TEST Supabase project used by `npm test`.
# Copy to .env.test.local and fill in from the test project's dashboard
# (Settings > API + Connect > Direct connection). NEVER use production creds
# here — tests/setup.ts refuses to run fixture-writing tests against any
# project ref not on the allow-list in tests/helpers/testdb.ts.
TEST_SUPABASE_URL=https://rjwuwmrzkyergflmmfxq.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# Only needed to run scripts/testdb/reset.ts (migration replay + seed):
# TEST_SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.rjwuwmrzkyergflmmfxq.supabase.co:5432/postgres
