# Word/Excel temp lock files
~$*

# Grounding pipeline: regenerable batch I/O + runtime held-dispute log
# (the audit records — *.fixes.json, *.keyfix.json, verify*.json — ARE tracked)
scripts/grounding/data/*.input.json
scripts/grounding/data/*.solution.json
scripts/logs/

# State Board / NCERT ingestion — DB dumps fed to agents, regenerable any time via
# dump-subjective.ts / dump-review.ts / dump-mcq.ts. The transcription fragments,
# *.solutions.json, *.mcq-verify.json, *.errata.json and the *.xcheck.json audit
# records ARE tracked (source of truth + the answer-key-gate trail).
scripts/stateboard/data/*.topaper.json
scripts/stateboard/data/*.review.json
scripts/stateboard/data/*.mcq-blind.json
scripts/ncert/data/*.topaper.json
scripts/ncert/data/*.review.json
scripts/ncert/data/*.mcq-blind.json
scripts/mh-sb-9/data/*.topaper.json
scripts/mh-sb-9/data/*.review.json
scripts/mh-sb-9/data/*.mcq-blind.json
scripts/mh-sb-11/data/*.topaper.json
scripts/mh-sb-11/data/*.review.json
scripts/mh-sb-11/data/*.mcq-blind.json
scripts/mh-ssc-10-text/data/*.topaper.json
scripts/mh-ssc-10-text/data/*.review.json
scripts/mh-ssc-10-text/data/*.mcq-blind.json

# Generated paper outputs — regenerable build artifacts, not tracked
generated-papers/*.xlsx
generated-papers/*.docx
generated-papers/*.pdf
generated-papers/*.md
generated-papers/*.html

# Teaching-plan rendered outputs — regenerable from the JSON via build-docx.py
teaching-plan/*.docx
teaching-plan/*.pdf
__pycache__/
generated-papers/*.tex

# Supabase CLI project-ref cache (created by `supabase postgres-config` etc.)
supabase/.temp/

# Local database backups (npm run db:backup). NEVER commit these: the repo is
# public and the dumps carry student mobiles, quiz-lead consent records and the
# full auth.users table. Whole directory, so a new artifact type can't slip out.
backups/

# Transient spine snapshots (scripts/syllabus/renumber-rulings.ts --snapshot).
# Written immediately BEFORE a bank-spine re-ingest and consumed immediately
# after, purely to carry the old (chapter, subtopic) pairs across the renumber.
# Committing one would leave a stale map in the tree that looks authoritative.
scripts/syllabus/data/.spine-snapshot-*.json

# scripts/reviews: regenerable working dumps (redump-papers.ts). Evidence lives
# in data/blind/<run>/ and data/findings/<run>/, which ARE committed.
scripts/reviews/data/audit-run/
