#!/bin/sh
# Local gate before pushing to remote. Runs the same checks as CI
# (.github/workflows/ci.yml) — typecheck, lint, docs:budget, notes:latex,
# conditionally notes:lint, test — so a green pre-push means a green CI.
# Single source of truth: the `prepush:quick*` scripts in package.json; this
# file only picks WHICH of the two to run.
#
# NO BUILD HERE (2026-10-09). A `next build` prerenders ~3,400 pages against
# the PRODUCTION database, and the local one has taken that database down
# twice (2026-10-04, 2026-10-09: 3,700 requests a minute from a machine 50 ms
# from Mumbai, then a 30-minute outage for every signed-in visitor). The deploy
# workflow (.github/workflows/deploy.yml) builds the same commit on GitHub
# before anything goes live and refuses to deploy a failure, so a broken build
# still cannot reach the site; it is found ~15 minutes later, on a runner
# whose request rate the database has survived every day. A build by hand is
# still `npm run build` (or `npm run gate prepush`), and is now protected by
# the build-phase fetch cap in src/lib/supabase/buildFetch.ts — but do not run
# one casually; it still reads production.
#
# Why the full chain (not just typecheck): pre-push used to run only
# typecheck+lint+build, so a broken TEST passed pre-push and only failed
# in CI (2026-06-02 — notes-index-helper after shipping a notes chapter).
# Catching that class locally is the point.
#
# CONDITIONAL notes:lint (2026-09-21). It validates the /notes editorial
# modules against the LIVE taxonomy + tags — 91 s, and it grows with the bank.
# Only a change under the roots it reads (src/app/notes, src/lib/notes, the
# lint itself, the schema, deps) can move its verdict, so it now runs only
# then. An allowlist of RUNS, pinned to the lint's real import graph by
# tests/notes-lint-import-roots.test.ts. Rule: scripts/lib/needsNotesLint.ts.
#
# Cost, MEASURED 2026-09-21 (12 cores): static checks 16 s · notes:lint 91 s ·
# test ~2.5 min at maxForks 5. Escape hatch for WIP pushes:
# `git push --no-verify` — but know why before you reach for it.

set -e

# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" per ref.
# Read only a single-ref push; anything else leaves base empty, and an empty
# base makes the rule fail safe to "run".
base=""
head="HEAD"
refs=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  refs=$((refs + 1))
  base="$remote_sha"
  head="$local_sha"
done
if [ "$refs" -ne 1 ]; then
  base=""
  head="HEAD"
fi

# All-zero local sha = branch deletion. Nothing to gate.
case "$head" in
  0000000000000000000000000000000000000000)
    echo "[pre-push] branch deletion — nothing to gate"
    exit 0
    ;;
esac

notes=0
if npx tsx scripts/needs-notes-lint.ts "$base" "$head"; then notes=1; fi

if [ "$notes" -eq 1 ]; then
  target="prepush:quick"
else
  target="prepush:quick:nonotes"
fi

echo "[pre-push] running npm run $target (notes:lint=$notes; no build — GitHub builds the push)..."

# KEEP THE OUTPUT (2026-10-06). A red gate used to leave nothing behind but
# the terminal, so a failure seen once could not be read again: a 36-test red
# run that day was lost to `| tail -40`, and every earlier flake fix had been a
# guess from fragments. Each run now writes its full output to a timestamped
# log (gitignored, newest 20 kept). The exit code is carried out of the pipe in
# a file, because a pipeline reports tee's status, not the gate's.
log_dir="generated-papers/gate-logs"
mkdir -p "$log_dir"
log="$log_dir/pre-push-$(date +%Y%m%d-%H%M%S).log"
{ npm run "$target" --silent 2>&1; echo $? > "$log.status"; } | tee "$log"
code=$(cat "$log.status" 2>/dev/null || echo 1)
rm -f "$log.status"
for old in $(ls -1t "$log_dir"/pre-push-*.log 2>/dev/null | tail -n +21); do rm -f "$old"; done
if [ "$code" -ne 0 ]; then
  echo "[pre-push] FAILED (exit $code). Full output: $log"
  exit "$code"
fi

echo "[pre-push] all gates passed"
