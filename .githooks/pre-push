#!/bin/sh
# Local gate before pushing to remote. Runs the SAME chain as CI
# (.github/workflows/ci.yml) — typecheck, lint, notes:lint, notes:latex, test,
# and conditionally build — so a green pre-push means a green CI. Single source
# of truth: the `prepush` / `prepush:quick` scripts in package.json.
#
# Why the full chain (not just build): pre-push used to run only
# typecheck+lint+build, so a broken TEST passed pre-push and only failed
# in CI (2026-06-02 — notes-index-helper after shipping a notes chapter).
# Catching that class locally is the point. It also still catches the
# server<->client prop-serialization regressions that only fail under
# `next build` (the 2026-05-13 Pagination revert).
#
# CONDITIONAL BUILD (2026-08-05). `next build` prerenders 689 pages, ~317 of
# which query Postgres — ~25 MB of egress and a couple of minutes, every push,
# here AND again in CI. Measured over 30 days: 78 of 145 pushes to main changed
# nothing the compiler reads (ingestion data + docs), so that build could not
# have failed. It is now skipped for those pushes only; ANY change under src/,
# or to a build config, or to a path the rule doesn't recognise, still builds.
# The rule lives in scripts/lib/needsBuild.ts (spec: tests/needs-build.test.ts)
# and is shared with CI so the two gates cannot drift. It is an allowlist of
# SKIPS, so it can only ever be too cautious.
#
# Cost: ~3-4 min with a build, ~1-2 min without. Escape hatch for WIP pushes:
# `git push --no-verify` — but know why before you reach for it.

set -e

# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" per ref.
# Read only a single-ref push; anything else leaves base empty, and an empty
# base makes needs-build fail safe to "build".
base=""
head="HEAD"
refs=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  refs=$((refs + 1))
  base="$remote_sha"
  head="$local_sha"
done
if [ "$refs" -ne 1 ]; then
  base=""
  head="HEAD"
fi

# All-zero local sha = branch deletion. Nothing to gate.
case "$head" in
  0000000000000000000000000000000000000000)
    echo "[pre-push] branch deletion — nothing to gate"
    exit 0
    ;;
esac

if npx tsx scripts/needs-build.ts "$base" "$head"; then
  echo "[pre-push] running full gate (npm run prepush) — mirrors CI..."
  npm run prepush --silent
else
  echo "[pre-push] running gate without build (npm run prepush:quick)..."
  npm run prepush:quick --silent
fi

echo "[pre-push] all gates passed"
