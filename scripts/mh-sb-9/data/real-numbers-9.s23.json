    "difficulty": "EASY",
    "stem": "Simplify : \\(7\\sqrt{3} + 29\\sqrt{3}\\)",
    "solution": "\\(7\\sqrt{3} + 29\\sqrt{3} = (7 + 29)\\sqrt{3} = 36\\sqrt{3}\\)"
  },
  {
    "ref": "2.3 SolvedEx.2",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "EASY",
    "stem": "Simplify : \\(7\\sqrt{3} - 29\\sqrt{3}\\)",
    "solution": "\\(7\\sqrt{3} - 29\\sqrt{3} = (7 - 29)\\sqrt{3} = -22\\sqrt{3}\\)"
  },
  {
    "ref": "2.3 SolvedEx.3",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "MODERATE",
    "stem": "Simplify : \\(13\\sqrt{8} + \\frac{1}{2}\\sqrt{8} - 5\\sqrt{8}\\)",
    "solution": "\\(13\\sqrt{8} + \\frac{1}{2}\\sqrt{8} - 5\\sqrt{8} = \\left(13 + \\frac{1}{2} - 5\\right)\\sqrt{8} = \\left(\\frac{26 + 1 - 10}{2}\\right)\\sqrt{8}\\)\n\n\\(= \\frac{17}{2}\\sqrt{8} = \\frac{17}{2}\\sqrt{4 \\times 2}\\)\n\n\\(= \\frac{17}{2} \\times 2\\sqrt{2} = 17\\sqrt{2}\\)"
  },
  {
    "ref": "2.3 SolvedEx.4",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "MODERATE",
    "stem": "Simplify : \\(8\\sqrt{5} + \\sqrt{20} - \\sqrt{125}\\)",
    "solution": "\\(8\\sqrt{5} + \\sqrt{20} - \\sqrt{125} = 8\\sqrt{5} + \\sqrt{4 \\times 5} - \\sqrt{25 \\times 5}\\)\n\n\\(= 8\\sqrt{5} + 2\\sqrt{5} - 5\\sqrt{5}\\)\n\n\\(= (8 + 2 - 5)\\sqrt{5}\\)\n\n\\(= 5\\sqrt{5}\\)"
  },
  {
    "ref": "2.3 SolvedEx.5",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "EASY",
    "stem": "Multiply the surds \\(\\sqrt{7} \\times \\sqrt{42}\\).",
    "solution": "\\(\\sqrt{7} \\times \\sqrt{42} = \\sqrt{7 \\times 42} = \\sqrt{7 \\times 7 \\times 6} = 7\\sqrt{6}\\)\n\n(\\(7\\sqrt{6}\\) is an irrational number.)"
  },
  {
    "ref": "2.3 SolvedEx.6",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "EASY",
    "stem": "Divide the surds : \\(\\sqrt{125} \\div \\sqrt{5}\\)",
    "solution": "\\(\\frac{\\sqrt{125}}{\\sqrt{5}} = \\sqrt{\\frac{125}{5}} = \\sqrt{25} = 5\\)\n\n(5 is a rational number.)"
  },
  {
    "ref": "2.3 SolvedEx.7",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Operations on Quadratic Surds",
    "difficulty": "EASY",
    "stem": "Simplify : \\(\\sqrt{50} \\times \\sqrt{18}\\)",
    "solution": "\\(\\sqrt{50} \\times \\sqrt{18} = \\sqrt{25 \\times 2} \\times \\sqrt{9 \\times 2} = 5\\sqrt{2} \\times 3\\sqrt{2} = 15 \\times 2 = 30\\)\n\nNote that the product and the quotient of two surds may be rational numbers."
  },
  {
    "ref": "2.3 SolvedEx.8",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Rationalization of the Denominator",
    "difficulty": "EASY",
    "stem": "If the surd \\(\\sqrt{2}\\) is multiplied by \\(\\sqrt{2}\\), what do we get? Hence state a rationalizing factor of \\(\\sqrt{2}\\).",
    "solution": "If surd \\(\\sqrt{2}\\) is multiplied by \\(\\sqrt{2}\\) we get \\(\\sqrt{2 \\times 2} = \\sqrt{4}\\). \\(\\sqrt{4} = 2\\) is a rational number.\n\n\\(\\therefore\\) \\(\\sqrt{2}\\) is a rationalizing factor of \\(\\sqrt{2}\\)."
  },
  {
    "ref": "2.3 SolvedEx.9",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Rationalization of the Denominator",
    "difficulty": "EASY",
    "stem": "Multiply \\(\\sqrt{2} \\times \\sqrt{8}\\).",
    "solution": "\\(\\sqrt{2} \\times \\sqrt{8} = \\sqrt{16} = 4\\) is a rational number.\n\n\\(\\therefore\\) \\(\\sqrt{2}\\) is the rationalizing factor of \\(\\sqrt{8}\\).\n\nSimilarly \\(8\\sqrt{2}\\) is also a rationalizing factor of \\(\\sqrt{2}\\), because \\(\\sqrt{2} \\times 8\\sqrt{2} = 8\\sqrt{2} \\times \\sqrt{2} = 8 \\times 2 = 16\\)."
  },
  {
    "ref": "2.3 SolvedEx.10",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Rationalization of the Denominator",
    "difficulty": "MODERATE",
    "stem": "Find the rationalizing factor of \\(\\sqrt{27}\\).",
    "solution": "\\(\\sqrt{27} = \\sqrt{9 \\times 3} = 3\\sqrt{3}\\)\n\n\\(\\therefore\\) \\(3\\sqrt{3} \\times \\sqrt{3} = 3 \\times 3 = 9\\) is a rational number.\n\n\\(\\therefore\\) \\(\\sqrt{3}\\) is the rationalizing factor of \\(\\sqrt{27}\\).\n\nNote that \\(\\sqrt{27} = 3\\sqrt{3}\\) means \\(3\\sqrt{3} \\times 3\\sqrt{3} = 9 \\times 3 = 27\\).\n\nHence \\(3\\sqrt{3}\\) is also a rationalizing factor of \\(\\sqrt{27}\\). In the same way \\(4\\sqrt{3}\\), \\(7\\sqrt{3}\\), \\(\\ldots\\) are also the rationalizing factors of \\(\\sqrt{27}\\). Out of all these \\(\\sqrt{3}\\) is the simplest rationalizing factor."
  },
  {
    "ref": "2.3 SolvedEx.11",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Rationalization of the Denominator",
    "difficulty": "EASY",
    "stem": "Rationalize the denominator of \\(\\frac{1}{\\sqrt{5}}\\).",
    "solution": "\\(\\frac{1}{\\sqrt{5}} = \\frac{1}{\\sqrt{5}} \\times \\frac{\\sqrt{5}}{\\sqrt{5}} = \\frac{\\sqrt{5}}{5}\\)\n\n....(multiply numerator and denominator by \\(\\sqrt{5}\\).)"
  },
  {
    "ref": "2.3 SolvedEx.12",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Rationalization of the Denominator",
    "difficulty": "MODERATE",
    "stem": "Rationalize the denominator of \\(\\frac{3}{2\\sqrt{7}}\\).",
    "solution": "\\(\\frac{3}{2\\sqrt{7}} = \\frac{3}{2\\sqrt{7}} \\times \\frac{\\sqrt{7}}{\\sqrt{7}} = \\frac{3\\sqrt{7}}{2 \\times 7} = \\frac{3\\sqrt{7}}{14}\\)\n\n...(multiplying \\(2\\sqrt{7}\\) by \\(\\sqrt{7}\\) is sufficient to rationalize.)"
  },

