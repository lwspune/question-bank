    "setLabel": "3.6 SolvedEx.recall",
    "stem": "\\(4x^2 - 25\\)",
    "solution": "\\(4x^2 - 25\\)\n\\(= (2x)^2 - (5)^2\\)\n\\(= (2x + 5)(2x - 5)\\)"
  },
  {
    "ref": "3.6 SolvedEx.2",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Factorization of Polynomials",
    "difficulty": "EASY",
    "context": "Factorize.",
    "setLabel": "3.6 SolvedEx.recall",
    "stem": "\\(3x^2 + 7x + 2\\)",
    "solution": "\\(3x^2 + 7x + 2\\)\n\\(= 3x^2 + 6x + x + 2\\)\n\\(= 3x(x + 2) + 1(x + 2)\\)\n\\(= (x + 2)(3x + 1)\\)"
  },
  {
    "ref": "3.6 SolvedEx.3",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Factorization of Polynomials",
    "difficulty": "MODERATE",
    "context": "Factorize.",
    "setLabel": "3.6 SolvedEx.recall",
    "stem": "\\(63x^2 + 5x - 2\\)",
    "solution": "\\(63x^2 + 5x - 2\\)\n\\(= 63x^2 + 14x - 9x - 2\\)\n\\(= 7x(9x + 2) - 1(9x + 2)\\)\n\\(= (9x + 2)(7x - 1)\\)"
  },
  {
    "ref": "3.6 SolvedEx.4",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Factorization of Polynomials",
    "difficulty": "MODERATE",
    "context": "Factorize.",
    "setLabel": "3.6 SolvedEx.recall",
    "stem": "\\(6x^2 - 5x - 6\\)",
    "solution": "\\(6x^2 - 5x - 6\\)\n\\(= 6x^2 - 9x + 4x - 6\\)\n\\(= 3x(2x - 3) + 2(2x - 3)\\)\n\\(= (2x - 3)(3x + 2)\\)"
  },
  {
    "ref": "3.6 SolvedEx.5",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Factorization of Polynomials",
    "difficulty": "HARD",
    "stem": "Factorise : \\((y^2 - 3y)^2 - 5(y^2 - 3y) - 50\\).",
    "solution": "Let \\((y^2 - 3y) = x\\)\n\\(\\therefore (y^2 - 3y)^2 - 5(y^2 - 3y) - 50 = x^2 - 5x - 50\\)\n\\(= x^2 - 10x + 5x - 50\\)\n\\(= x(x - 10) + 5(x - 10)\\)\n\\(= (x - 10)(x + 5)\\)\n\\(= (y^2 - 3y - 10)(y^2 - 3y + 5)\\)\n\\(= [y^2 - 5y + 2y - 10](y^2 - 3y + 5)\\)\n\\(= [y(y - 5) + 2(y - 5)](y^2 - 3y + 5)\\)\n\\(= (y - 5)(y + 2)(y^2 - 3y + 5)\\)"
  },
  {
    "ref": "3.6 SolvedEx.6",
    "bucket": "solved",
    "format": "subjective",
    "subtopic": "Factorization of Polynomials",
    "difficulty": "HARD",
    "stem": "Factorise : \\((x + 2)(x - 3)(x - 7)(x - 2) + 64\\).",
    "solution": "\\((x + 2)(x - 3)(x - 7)(x - 2) + 64\\)\n\\(= (x + 2)(x - 7)(x - 3)(x - 2) + 64\\)\n\\(= (x^2 - 5x - 14)(x^2 - 5x + 6) + 64\\)\n\\(= (m - 14)(m + 6) + 64\\) ....... (putting \\(x^2 - 5x = m\\))\n\\(= m^2 - 14m + 6m - 84 + 64\\)\n\\(= m^2 - 8m - 20\\)\n\\(= (m - 10)(m + 2)\\)\n\\(= (x^2 - 5x - 10)(x^2 - 5x + 2)\\) .... (replace \\(m\\) with \\(x^2 - 5x\\))"
  },

