  { "ref": "Misc Q32", "book_key": "(proof — target \\tfrac23+\\log\\tfrac23 stated in stem; no separate key entry)", "our_answer": "\\tfrac23+\\log\\tfrac23", "verdict": "AGREE", "note": "Proof question. Partial fractions 1/(x^2(x+1)) = -1/x + 1/x^2 + 1/(x+1); antiderivative \\log|(x+1)/x|-1/x; evaluated 1\\to3 gives \\log\\tfrac46+\\tfrac23 = \\tfrac23+\\log\\tfrac23. Reaches stated result." },
  { "ref": "Misc Q33", "book_key": "(proof — target 1 stated in stem)", "our_answer": "1", "verdict": "AGREE", "note": "Proof. \\int xe^x dx = e^x(x-1); [e^x(x-1)]_0^1 = 0-(-1) = 1. Reaches stated result." },
  { "ref": "Misc Q34", "book_key": "(proof — target 0 stated in stem)", "our_answer": "0", "verdict": "AGREE", "note": "Proof. x^{17}\\cos^4 x is odd (odd\\times even), so \\int_{-1}^{1}=0. Correct." },
  { "ref": "Misc Q35", "book_key": "(proof — target \\tfrac23 stated in stem)", "our_answer": "\\dfrac{2}{3}", "verdict": "AGREE", "note": "Proof. \\sin^3 x = (3\\sin x-\\sin 3x)/4; evaluates to 2/3. Correct." },
  { "ref": "Misc Q36", "book_key": "(proof — target 1-\\log 2 stated in stem)", "our_answer": "1-\\log 2", "verdict": "AGREE", "note": "Proof. \\int 2\\tan^3 x dx = \\tan^2 x - 2\\log|\\sec x|; at \\pi/4 gives 1-\\log 2, at 0 gives 0. Correct." },
  { "ref": "Misc Q37", "book_key": "(proof — target \\tfrac{\\pi}{2}-1 stated in stem)", "our_answer": "\\dfrac{\\pi}{2}-1", "verdict": "AGREE", "note": "Proof. By parts \\int\\sin^{-1}x dx = x\\sin^{-1}x+\\sqrt{1-x^2}; [..]_0^1 = (\\pi/2+0)-(0+1) = \\pi/2-1. Correct." },
  { "ref": "Misc Q38", "book_key": "A (\\tan^{-1}(e^x)+C)", "our_answer": "A", "verdict": "AGREE", "note": "\\int dx/(e^x+e^{-x}) = \\int e^x dx/(e^{2x}+1); t=e^x \\to \\int dt/(t^2+1) = \\tan^{-1}(e^x)+C, option A. Matches key A." },
  { "ref": "Misc Q39", "book_key": "B (\\log|\\sin x+\\cos x|+C)", "our_answer": "B", "verdict": "AGREE", "note": "\\cos 2x/(\\sin x+\\cos x)^2 = (\\cos x-\\sin x)/(\\sin x+\\cos x) = d/dx\\log|\\sin x+\\cos x|; integral = \\log|\\sin x+\\cos x|+C, option B. Matches key B." },
