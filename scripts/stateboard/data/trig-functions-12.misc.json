    "format": "mcq",
    "subtopic": "Trigonometric Equations and General Solutions",
    "difficulty": "MODERATE",
    "stem": "The principal solutions of the equation \\(\\sin\\theta = \\dfrac{-1}{2}\\) are ______.",
    "options": [
      {"label": "A", "text": "\\(\\dfrac{5\\pi}{6},\\ \\dfrac{\\pi}{6}\\)"},
      {"label": "B", "text": "\\(\\dfrac{7\\pi}{6},\\ \\dfrac{11\\pi}{6}\\)"},
      {"label": "C", "text": "\\(\\dfrac{\\pi}{6},\\ \\dfrac{7\\pi}{6}\\)"},
      {"label": "D", "text": "\\(\\dfrac{7\\pi}{6},\\ \\dfrac{\\pi}{6}\\)"}
    ],
    "answer": "B",
    "solution": "\\(\\sin\\theta=-\\tfrac12\\) is negative, so \\(\\theta\\) lies in the third and fourth quadrants in \\([0,2\\pi)\\): \\(\\theta=\\pi+\\tfrac{\\pi}{6}=\\tfrac{7\\pi}{6}\\) and \\(\\theta=2\\pi-\\tfrac{\\pi}{6}=\\tfrac{11\\pi}{6}\\)."
  },
  {
    "ref": "Misc I Q.2",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Trigonometric Equations and General Solutions",
    "difficulty": "MODERATE",
    "stem": "The principal solutions of the equation \\(\\cot\\theta = \\sqrt{3}\\) are ______.",
    "options": [
      {"label": "A", "text": "\\(\\dfrac{\\pi}{6},\\ \\dfrac{7\\pi}{6}\\)"},
      {"label": "B", "text": "\\(\\dfrac{\\pi}{6},\\ \\dfrac{5\\pi}{6}\\)"},
      {"label": "C", "text": "\\(\\dfrac{\\pi}{6},\\ \\dfrac{8\\pi}{6}\\)"},
      {"label": "D", "text": "\\(\\dfrac{7\\pi}{6},\\ \\dfrac{\\pi}{6}\\)"}
    ],
    "answer": "A",
    "solution": "\\(\\cot\\theta=\\sqrt3\\Rightarrow\\tan\\theta=\\tfrac{1}{\\sqrt3}\\), positive, so \\(\\theta\\) is in the first and third quadrants: \\(\\theta=\\tfrac{\\pi}{6}\\) and \\(\\theta=\\pi+\\tfrac{\\pi}{6}=\\tfrac{7\\pi}{6}\\)."
  },
  {
    "ref": "Misc I Q.3",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Trigonometric Equations and General Solutions",
    "difficulty": "MODERATE",
    "stem": "The general solution of \\(\\sec x = \\sqrt{2}\\) is ______.",
    "options": [
      {"label": "A", "text": "\\(2n\\pi \\pm \\dfrac{\\pi}{4},\\ n \\in \\mathbb{Z}\\)"},
      {"label": "B", "text": "\\(2n\\pi \\pm \\dfrac{\\pi}{2},\\ n \\in \\mathbb{Z}\\)"},
      {"label": "C", "text": "\\(n\\pi \\pm \\dfrac{\\pi}{2},\\ n \\in \\mathbb{Z}\\)"},
      {"label": "D", "text": "\\(2n\\pi \\pm \\dfrac{\\pi}{3},\\ n \\in \\mathbb{Z}\\)"}
    ],
    "answer": "A",
    "solution": "\\(\\sec x=\\sqrt2\\Rightarrow\\cos x=\\tfrac{1}{\\sqrt2}=\\cos\\tfrac{\\pi}{4}\\), so \\(x=2n\\pi\\pm\\tfrac{\\pi}{4}\\)."
  },
  {
    "ref": "Misc I Q.4",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Trigonometric Equations and General Solutions",
    "difficulty": "MODERATE",
    "stem": "If \\(\\cos p\\theta = \\cos q\\theta,\\ p \\neq q\\) then ______.",
    "options": [
      {"label": "A", "text": "\\(\\theta = \\dfrac{2n\\pi}{p \\pm q}\\)"},
      {"label": "B", "text": "\\(\\theta = 2n\\pi\\)"},
      {"label": "C", "text": "\\(\\theta = 2n\\pi \\pm p\\)"},
      {"label": "D", "text": "\\(np + q\\)"}
    ],
    "answer": "A",
    "solution": "\\(\\cos p\\theta=\\cos q\\theta\\Rightarrow p\\theta=2n\\pi\\pm q\\theta\\Rightarrow(p\\mp q)\\theta=2n\\pi\\Rightarrow\\theta=\\tfrac{2n\\pi}{p\\pm q}\\)."
  },
  {
    "ref": "Misc I Q.5",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Polar Coordinates",
    "difficulty": "EASY",
    "stem": "If the polar co-ordinates of a point are \\(\\left(2, \\dfrac{\\pi}{4}\\right)\\) then its cartesian co-ordinates are ______.",
