    ],
    "answer": "B",
    "solution": "\\(\\tfrac{7\\pi}{6}\\notin[0,\\pi]\\). \\(\\cos\\tfrac{7\\pi}{6}=-\\tfrac{\\sqrt3}{2}\\), and \\(\\cos^{-1}\\!\\left(-\\tfrac{\\sqrt3}{2}\\right)=\\tfrac{5\\pi}{6}\\) (equivalently \\(2\\pi-\\tfrac{7\\pi}{6}=\\tfrac{5\\pi}{6}\\))."
  },
