  {
    "ref": "Misc I Q.9",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Applications of Sine, Cosine and Projection Rules",
    "difficulty": "MODERATE",
    "stem": "In \\(\\triangle ABC\\), \\(ac\\cos B - bc\\cos A = \\) ______.",
