  {
    "ref": "Misc I Q.13",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Properties of Inverse Trigonometric Functions",
    "difficulty": "MODERATE",
    "stem": "If \\(\\sin^{-1}\\dfrac{4}{5} + \\cos^{-1}\\dfrac{12}{13} = \\sin^{-1}\\alpha\\), then \\(\\alpha = \\) ______.",
    "options": [
      {"label": "A", "text": "\\(\\dfrac{63}{65}\\)"},
      {"label": "B", "text": "\\(\\dfrac{62}{65}\\)"},
      {"label": "C", "text": "\\(\\dfrac{61}{65}\\)"},
      {"label": "D", "text": "\\(\\dfrac{60}{65}\\)"}
    ],
    "answer": "A",
    "solution": "Let \\(P=\\sin^{-1}\\tfrac45\\ (\\sin P=\\tfrac45,\\cos P=\\tfrac35)\\), \\(Q=\\cos^{-1}\\tfrac{12}{13}\\ (\\cos Q=\\tfrac{12}{13},\\sin Q=\\tfrac{5}{13})\\). \\(\\sin(P+Q)=\\tfrac45\\cdot\\tfrac{12}{13}+\\tfrac35\\cdot\\tfrac{5}{13}=\\tfrac{48+15}{65}=\\tfrac{63}{65}\\)."
  },
  {
    "ref": "Misc I Q.14",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Properties of Inverse Trigonometric Functions",
    "difficulty": "MODERATE",
    "stem": "If \\(\\tan^{-1}(2x) + \\tan^{-1}(3x) = \\dfrac{\\pi}{4}\\), then \\(x = \\) ______.",
    "options": [
      {"label": "A", "text": "\\(-1\\)"},
      {"label": "B", "text": "\\(\\dfrac{1}{6}\\)"},
      {"label": "C", "text": "\\(\\dfrac{2}{6}\\)"},
      {"label": "D", "text": "\\(\\dfrac{3}{2}\\)"}
    ],
    "answer": "B",
    "solution": "\\(\\tan^{-1}\\dfrac{2x+3x}{1-6x^{2}}=\\tfrac{\\pi}{4}\\Rightarrow\\dfrac{5x}{1-6x^{2}}=1\\Rightarrow6x^{2}+5x-1=0\\Rightarrow(6x-1)(x+1)=0\\). \\(x=-1\\) is rejected (gives a negative sum), so \\(x=\\tfrac16\\)."
  },
  {
    "ref": "Misc I Q.15",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Properties of Inverse Trigonometric Functions",
    "difficulty": "MODERATE",
    "stem": "\\(2\\tan^{-1}\\left(\\dfrac{1}{3}\\right) + \\tan^{-1}\\left(\\dfrac{1}{7}\\right) = \\) ______.",
    "options": [
      {"label": "A", "text": "\\(\\tan^{-1}\\left(\\dfrac{4}{5}\\right)\\)"},
      {"label": "B", "text": "\\(\\dfrac{\\pi}{2}\\)"},
      {"label": "C", "text": "\\(1\\)"},
      {"label": "D", "text": "\\(\\dfrac{\\pi}{4}\\)"}
    ],
    "answer": "D",
    "solution": "\\(2\\tan^{-1}\\tfrac13=\\tan^{-1}\\dfrac{2/3}{1-1/9}=\\tan^{-1}\\tfrac34\\). Then \\(\\tan^{-1}\\tfrac34+\\tan^{-1}\\tfrac17=\\tan^{-1}\\dfrac{3/4+1/7}{1-3/28}=\\tan^{-1}1=\\tfrac{\\pi}{4}\\)."
  },
  {
    "ref": "Misc I Q.16",
    "bucket": "exercise-mcq",
    "format": "mcq",
    "subtopic": "Properties of Inverse Trigonometric Functions",
    "difficulty": "MODERATE",
    "stem": "\\(\\tan\\left[2\\tan^{-1}\\left(\\dfrac{1}{5}\\right) - \\dfrac{\\pi}{4}\\right] = \\) ______.",
    "options": [
      {"label": "A", "text": "\\(\\dfrac{17}{7}\\)"},
      {"label": "B", "text": "\\(-\\dfrac{17}{7}\\)"},
      {"label": "C", "text": "\\(\\dfrac{7}{17}\\)"},
      {"label": "D", "text": "\\(-\\dfrac{7}{17}\\)"}
    ],
    "answer": "D",
    "solution": "\\(2\\tan^{-1}\\tfrac15=\\tan^{-1}\\dfrac{2/5}{1-1/25}=\\tan^{-1}\\tfrac{5}{12}\\). With \\(\\tan\\theta=\\tfrac{5}{12}\\), \\(\\tan(\\theta-\\tfrac{\\pi}{4})=\\dfrac{5/12-1}{1+5/12}=\\dfrac{-7/12}{17/12}=-\\tfrac{7}{17}\\)."
  },
