    "subtopic": "Properties of Inverse Trigonometric Functions",
    "difficulty": "MODERATE",
    "stem": "\\(\\cos\\left[\\tan^{-1}\\dfrac{1}{3} + \\tan^{-1}\\dfrac{1}{2}\\right] = \\) ______.",
    "options": [
      {"label": "A", "text": "\\(\\dfrac{1}{\\sqrt{2}}\\)"},
      {"label": "B", "text": "\\(\\dfrac{\\sqrt{3}}{2}\\)"},
