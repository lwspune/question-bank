    "solution": "\\(2\\tan^{-1}\\tfrac15=\\tan^{-1}\\tfrac{2/5}{1-1/25}=\\tan^{-1}\\tfrac{5}{12}\\); with \\(\\tan\\phi=\\tfrac{5}{12}\\), \\(\\tan(\\phi-\\tfrac{\\pi}{4})=\\tfrac{5/12-1}{1+5/12}=\\tfrac{-7/12}{17/12}=-\\tfrac{7}{17}\\)."
  },
